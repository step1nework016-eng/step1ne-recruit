+
+def _topics_of(text):
+    return [t for t, pat in _TECH_TOPICS.items() if re.search(pat, str(text or ''))]
+
+
+def _is_negative(text):
+    t = re.sub(r'[\s，,。.！!？?~～、]', '', str(text or ''))
+    return bool(t) and len(t) <= 12 and bool(_NEG_REPLY.match(t))
