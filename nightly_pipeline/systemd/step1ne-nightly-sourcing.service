[Unit]
Description=Step1ne 幫優先職缺找人選（一天三輪，每職缺最多 10 位）
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/claude-projects/工作流程技能包/step1ne-recruit/nightly_pipeline
Environment=TZ=Asia/Taipei
# PATH 裡的 node 路徑請換成這台實際 `dirname $(which claude)` 所在的資料夾
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/current/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/claude-projects/工作流程技能包/step1ne-recruit/nightly_pipeline/run_nightly.sh sourcing --per-job 10 --priority-only
# 開跑前若有面談進行中，最多等 20 分鐘（找人會開 claude 和瀏覽器，不要跟面談搶）
Environment=NIGHTLY_WAIT_IDLE_MIN=20
TimeoutStartSec=5h15min
Nice=10
# 服務結束時，systemd 會把這個服務底下還活著的程序（包含沒關掉的 chromium）全部收掉
KillMode=control-group
