<!doctype html>
<meta charset="utf-8">
<title>{{DOC_TITLE}}</title>
<!--
  客戶版（給用人企業）樣板。
  ⚠️ 版面、配色、區塊順序、光譜圖都是 2026-08-10 Jacky 看過三輪後拍板的，
     不要重新設計。這份檔案只把資料位置換成 {{變數}}，其餘一個字都沒動。
  ⚠️ 哪些內容絕對不能出現在這一版，見 memory/report_two_versions_spec.md，
     過濾邏輯寫在 deliver.py 的 CLIENT_BANNED_RE 與 build_client_view()。
  語法：{{VAR}} = 直接代換；<!--@IF:key@-->…<!--@ENDIF:key@--> = 沒資料就整段刪掉。
-->
<style>
:root{--gold:#a67c3d;--gold2:#c9a049;--ink:#23262d;--ink2:#4d5563;--ink3:#8a8d95;
 --line:#eee7db;--soft:#faf8f3;--ok:#2f8f5b;--bad:#c0392b;--bg:#f4f1ea}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
 font:15px/1.75 -apple-system,"Noto Sans TC",sans-serif;padding:26px 14px}
.wrap{max-width:820px;margin:0 auto}
.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px 24px;margin-bottom:14px}
h2{font-size:14px;margin:0 0 15px;letter-spacing:.06em;color:var(--ink3);font-weight:700}
h3{font-size:13.5px;margin:20px 0 9px;color:var(--gold)}
.hero{background:var(--ink);color:#fff;border-radius:18px;padding:24px 26px;margin-bottom:14px}
.brand{font-size:11px;letter-spacing:.16em;color:var(--gold2);font-weight:700}
.hero h1{font-size:23px;margin:14px 0 3px}
.hero .sub{font-size:14px;color:#a8adb8;margin:0 0 18px}
.hero .pos{font-size:16.5px;line-height:1.7;margin:0 0 18px;color:#e8e4dc}
.nums{display:flex;gap:26px;flex-wrap:wrap;border-top:1px solid #3a3f49;padding-top:15px}
.nums div{font-size:12px;color:#a8adb8}
.nums b{display:block;color:#fff;font-size:16px;font-weight:700;margin-top:2px}
/* 2026-09-04 改：原本是橫向可捲動時間軸＋下面另一段「各段實際做了什麼」
   兩段重複顯示同一份資料——橫向那段在PDF/列印沒有捲軸會被切斷（Jacky回報
   過的「這邊有被截到」的根因），改成新版指定的垂直時間軸，一個列表同時
   顯示時間軸視覺＋完整內容，不會超版、也不會重複。 */
.track{border-left:2px solid var(--line);margin-left:6px}
.job{position:relative;padding:0 0 20px 22px}
.job:last-child{padding-bottom:0}
.job::before{content:'';position:absolute;left:-6px;top:3px;width:10px;height:10px;
 border-radius:50%;background:var(--gold)}
.job:first-child::before{width:13px;height:13px;left:-7.5px;background:#fff;border:3px solid var(--gold)}
.job.dim::before{background:#fff;border:2px dashed #c9c4b8}
.job .period{font-size:12px;color:var(--ink3);font-variant-numeric:tabular-nums;margin-bottom:2px}
.job .period.unk{color:#b9bcc4}
.job .co{font-weight:700;font-size:14.5px;color:var(--ink)}
.job .role{color:var(--ink2);font-size:13px;margin-top:1px}
.job p{margin:6px 0 0;font-size:13.5px;color:var(--ink2);line-height:1.7}
dl{display:grid;grid-template-columns:auto 1fr;gap:8px 15px;margin:0;font-size:14px}
dt{color:var(--ink3);white-space:nowrap} dd{margin:0;color:var(--ink2)}
.cond{display:grid;gap:8px}
.cond div{display:grid;grid-template-columns:20px 1fr;gap:11px;align-items:start;
 background:var(--soft);border-radius:10px;padding:11px 14px;font-size:14px}
.cond em{font-style:normal;color:var(--ink2);font-size:13px;display:block;margin-top:2px}
ol{margin:0;padding-left:20px} ol li{margin-bottom:9px;color:var(--ink2);font-size:14.5px}
ol li b{color:var(--ink)}
.reasons{display:flex;flex-direction:column;gap:12px}
.reason{display:flex;gap:12px;font-size:14.5px;line-height:1.7;color:var(--ink2)}
.reason .num{background:var(--gold);color:#fff;width:22px;height:22px;border-radius:50%;
 display:flex;align-items:center;justify-content:center;font-size:11.5px;font-weight:800;
 flex:none;margin-top:1px}
.spec{display:flex;flex-direction:column;gap:18px}
.spec .axis .row{display:grid;grid-template-columns:82px 1fr 82px;gap:12px;align-items:center;font-size:12px}
.spec s{text-decoration:none;color:var(--ink3);text-align:right}
.spec u{text-decoration:none;color:var(--ink);font-weight:600}
.spec i{position:relative;height:6px;border-radius:99px;
 background:linear-gradient(90deg,#efe9dd,#e3d3ae);display:block}
.spec i::after{content:"";position:absolute;top:50%;left:var(--p);width:13px;height:13px;
 margin:-6.5px 0 0 -6.5px;border-radius:50%;background:var(--gold);border:2.5px solid #fff;
 box-shadow:0 0 0 1.5px var(--gold)}
/* 2026-09-04 加：每一軸下面附一句面談中實際觀察到的原話，佐證這個點為什麼
   落在這裡——沒有這句話，光譜圖只是一個看起來有科學根據的抽象位置。 */
.spec .cap{font-size:11.5px;color:var(--ink3);margin-top:7px;padding-left:2px;display:flex;gap:5px}
.spec .cap b{color:var(--gold);font-weight:700;flex:none}
.specnote{font-size:11.5px;color:var(--ink3);margin:16px 0 0}

/* 2026-09-04 加：優勢／需要留意兩欄卡＋一句話總結，接在光譜圖後面。 */
.fitgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}
.fitcard{border-radius:10px;padding:14px 15px}
.fitcard.adv{background:#e9f5ee;border:1px solid #cfe9db}
.fitcard.risk2{background:#fdecea;border:1px solid #f5cfc9}
.fitcard h4{margin:0 0 8px;font-size:12.5px;display:flex;align-items:center;gap:6px}
.fitcard.adv h4{color:var(--ok)}
.fitcard.risk2 h4{color:var(--bad)}
.fitcard ul{margin:0;padding-left:16px;font-size:12.5px;line-height:1.7;color:var(--ink2)}
.oneliner{margin-top:16px;background:var(--soft);border-left:3px solid var(--gold);
 border-radius:0 8px 8px 0;padding:12px 16px;font-size:14px;font-weight:600;line-height:1.7}
.jobs{display:grid;gap:11px}
.jobs>div{background:var(--soft);border-radius:11px;padding:13px 16px}
.jobs b{font-size:14px}
.jobs s{text-decoration:none;color:var(--gold);font-size:11.5px;font-weight:700;margin-left:9px}
.jobs s.unk,.jobs s .unk{color:#b9bcc4;font-weight:600}
.jobs>div>p{margin:5px 0 0;font-size:13.5px;color:var(--ink2);line-height:1.7}
.jobs ul{margin:7px 0 0;padding-left:18px}
.jobs li{font-size:13.5px;color:var(--ink2);line-height:1.8;margin-bottom:2px}
.jobs li::marker{color:var(--gold2)}
.tags{display:flex;flex-wrap:wrap;gap:7px}
.tags span{background:var(--soft);border:1px solid var(--line);border-radius:999px;
 padding:5px 13px;font-size:13px;color:var(--ink2)}
.risk{background:#fffaf0;border:1px solid #e8d5ab;border-radius:11px;padding:14px 16px;
 font-size:14px;color:#7a5518;margin-top:14px}
.risk b{color:#5e400f}
.ask{background:var(--soft);border-left:3px solid var(--gold);border-radius:0 10px 10px 0;
 padding:11px 14px;margin-bottom:9px;font-size:13.5px;color:var(--ink)}
.files{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}
.files a{font-size:13.5px;font-weight:600;text-decoration:none;border:1px solid var(--line);
 border-radius:999px;padding:9px 18px;color:var(--ink2);background:#fff}
.foot{font-size:12px;color:var(--ink3);line-height:1.9;text-align:center;margin:22px 0 0}
.stamp{background:#fff;border:1px solid var(--line);border-radius:12px;padding:13px 17px;
 font-size:12.5px;color:var(--ink3);line-height:1.8}

  /* 基本資料：顧問拿到報告不用再去翻履歷才知道人住哪、幾歲 */
  .basics{border:1px solid var(--line,#eee7db);border-radius:12px;padding:13px 16px;margin:14px 0 0;
    background:var(--soft,#faf8f3);break-inside:avoid;}
  .basics h3{font-size:12.5px;margin:0 0 9px;color:var(--gold,#a67c3d);letter-spacing:.06em;}
  .bgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px 22px;}
  .bgrid div{display:flex;gap:10px;font-size:12.5px;line-height:1.65;}
  .bgrid i{font-style:normal;color:#8a8d95;white-space:nowrap;min-width:56px;}
  .bgrid b{color:#23262d;font-weight:600;}
  .bsrc{margin:9px 0 0;font-size:11px;color:#9a9da5;}
  @media print{.bgrid{grid-template-columns:repeat(2,1fr);}}

  /* 顧問電洽補充：2026-09-04 新增。跟其他區塊的金色系刻意區隔（藍色系），
     讓人一眼看出「這是顧問後來補的更新」，不是阿財面談當下的原始內容。 */
  .callup{background:#eef4fa;border:1px solid #cfe0ee;border-left:4px solid #4472a8;
    border-radius:0 12px 12px 0;padding:16px 18px;margin-bottom:14px;break-inside:avoid}
  .callup .chead{display:flex;align-items:center;justify-content:space-between;
    flex-wrap:wrap;gap:6px;margin-bottom:9px}
  .callup .chead b{font-size:14px;color:#2c4d70}
  .callup .chead span{font-size:11.5px;color:#5b7694;font-variant-numeric:tabular-nums}
  .callup p{margin:0;font-size:13.5px;color:var(--ink2);line-height:1.8}
</style>
<style>
@page{size:A4;margin:10mm}
@media print{
  body{background:#fff;padding:0}
  .wrap{max-width:none}
  /* 卡片本身允許跨頁，只保護「不該被切開的小單位」，
     否則整張卡搬到下一頁會留下大片空白 */
  .card{break-inside:auto;margin-bottom:9px;padding:15px 18px}
  .hero{padding:18px 20px;margin-bottom:9px}
  h2{margin-bottom:11px}
  h3{margin:15px 0 7px;break-after:avoid}
  .job,.cond div,.ask,.risk,.spec .axis,.callup,.fitcard,.oneliner,.stamp,ol li{break-inside:avoid}
  h2,h3,.job .co{break-after:avoid}
  .job{padding-bottom:14px}
  ol li{margin-bottom:6px}
  dl{gap:6px 15px}
  .foot{margin-top:14px}
}
</style>
<div class="wrap">

<div class="hero">
  <span class="brand">{{BRAND_LABEL}}</span>
  <h1>{{NAME}}</h1>
  <p class="sub">推薦職缺：{{JOB}}</p>
  <p class="pos">{{POSITIONING}}</p>
  <div class="nums">{{NUMS}}</div>
  {{BASICS}}
</div>

<!--@IF:reasons@-->
<div class="card">
  <h2>推薦理由</h2>
  <div class="reasons">{{REASONS}}</div>
</div>
<!--@ENDIF:reasons@-->

<!--@IF:callup@-->
<div class="card">
  <div class="callup">
    <div class="chead"><b>📞 顧問電洽補充</b><span>{{CALLUP_WHEN}}</span></div>
    <p>{{CALLUP_TEXT}}</p>
  </div>
</div>
<!--@ENDIF:callup@-->

<!--@IF:history@-->
<div class="card">
<!--@IF:social@-->
  <h2>候選人提供的社群連結</h2>
  {{SOCIAL}}
<!--@ENDIF:social@-->

<!--@IF:blockers@-->
  <h2>到職可行性</h2>
  <p class="note">{{TALK_KIND}}中確認過的到職相關條件與他的回答。標「還沒問到」的表示這場沒有問到，不是沒有問題。</p>
  {{BLOCKERS}}
<!--@ENDIF:blockers@-->

<!--@IF:expertise@-->
  <h2>專業問答</h2>
  <p class="note">以下是面談中針對這個職務的專業提問，以及他當下的回答（含原話引用）。
  這一段是為了讓您在安排面談之前，就能先判斷他的實務程度。</p>
  {{EXPERTISE}}
<!--@ENDIF:expertise@-->

  <h2>工作經歷</h2>
  <div class="track">{{JOBS}}</div>
  <dl>{{FACTS}}</dl>
</div>
<!--@ENDIF:history@-->

<!--@IF:cond@-->
<div class="card">
  <h2>與職缺條件對照</h2>
  <div class="cond">{{COND}}</div>
  {{RISKS}}
</div>
<!--@ENDIF:cond@-->

<!--@IF:asked@-->
<div class="card">
  <h2>人選{{TALK_KIND}}中主動提出的問題</h2>
  {{ASKED}}
</div>
<!--@ENDIF:asked@-->

<!--@IF:spectrum@-->
<div class="card">
  <h2>特質與風格</h2>
  <div class="spec">{{SPEC}}</div>
  <p class="specnote">由人選填寫完DISC測驗後，AI透過{{TALK_KIND}}中歸納評估結果{{SPEC_NOTE}}</p>

  <!--@IF:fit@-->
  <div class="fitgrid">
    <div class="fitcard adv">
      <h4>👍 對這個職缺的優勢</h4>
      <ul>{{FIT_PROS}}</ul>
    </div>
    <div class="fitcard risk2">
      <h4>⚠️ 需要留意的地方</h4>
      <ul>{{FIT_CONS}}</ul>
    </div>
  </div>
  <!--@ENDIF:fit@-->

  <!--@IF:oneliner@-->
  <div class="oneliner">💡 一句話總結：{{ONELINER}}</div>
  <!--@ENDIF:oneliner@-->
</div>
<!--@ENDIF:spectrum@-->

<div class="stamp">
  {{STAMP_TEXT}}
</div>

{{FOOTER}}

</div>
